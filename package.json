{
  "name": "rainy-words",
  "version": "1.0.0",
  "private": true,
  "description": "Rainy Words: a two-player typing race over sockets",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "set-host": "node scripts/set-host.js",
    "check:ai": "node scripts/check-ai.js",
