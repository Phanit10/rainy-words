# Rainy Words — AI settings.
# Copy this file to ".env" (same folder as server.js) and paste your key after the "=".
# Leave it empty to play offline: words come from wordbank.js and the commentator uses canned lines.
ANTHROPIC_API_KEY=

# Optional. Which Claude model writes the words and the commentary.
# LLM_MODEL=claude-opus-5-5

# AI theme words: a small model on this computer picks words that fit each match's theme. No key needed.
# THEME_AI=off            use the plain word bank instead

# Commentator voice: Kokoro text-to-speech. It runs on this computer and needs no key.
# VOICE=off               turn the spoken commentary off
# VOICE_NAME=af_heart     any Kokoro voice, e.g. am_michael, am_fenrir, bf_emma, bm_george
